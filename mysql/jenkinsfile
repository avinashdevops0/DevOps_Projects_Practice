pipeline {
  agent any

  environment {
    MYSQL_ROOT_PASSWORD = credentials('mysql-root-password')
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'nonocodes', url: 'https://github.com/avinashdevops0/DevOps_Projects_Practice.git'
      }
    }

    stage('Start MySQL') {
      steps {
        sh '
          docker-compose build && docker-compose up -d

        '
      }
    }

    stage('Verify MySQL') {
      steps {
        sh '''
          docker ps
          docker logs mysql_db
        '''
      }
    }
  }
}
